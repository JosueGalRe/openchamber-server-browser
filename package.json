{
  "name": "@josuegalre/openchamber-server-browser",
  "version": "0.6.0",
  "private": true,
  "description": "Server-owned Chrome browser provider and shared surface for OpenChamber",
  "type": "module",
  "license": "MIT",
  "repository": "github:JosueGalRe/openchamber-server-browser",
  "engines": {
    "node": ">=22"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.1"
    },
    "contributes": {
      "panel": {
        "id": "server-browser",
        "name": "Server Browser",
        "icon": "computer",
        "entry": "panel/index.html",
        "dock": "top",
        "size": 104
      },
      "page": {
        "entry": "panel/inspector.html",
        "title": "Browser inspector"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": [
          "browser"
        ],
        "surface": true,
        "permissions": {
          "exec": [
            "chromium",
            "google-chrome",
            "lsof",
            "ps"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "start": "node service/main.js",
    "check": "node --check service/main.js",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@openchamber/sdk": "2.0.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "esbuild": "0.28.0"
  }
}
